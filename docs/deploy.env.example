# ops/deploy.env.example — copy to ops/deploy.env (gitignored) and fill in.
# Host identity stays OUT of the repo; only this template is committed.

# SSH target: the deploy user + host on the shared box.
DEPLOY="sunset@your-hetzner-box"

# Absolute code dir on the box (state/ lives beside it, NOT under it).
APP="/opt/sunset-runner"

# systemd unit name (see ops/DEPLOYING.md for the unit file).
SERVICE="sunset-runner"

# Loopback port the service binds. Claim a free port in the shared-box registry
# and put the real value here (in ops/deploy.env, gitignored).
PORT="<PORT>"

# Extra ssh options as ONE string. Use $HOME (never ~) and -o Port=N (never -p),
# because rsync -e / scp exec ssh with no shell. Example:
#   SSH_OPTS="-i $HOME/.ssh/hetzner -o Port=22 -o StrictHostKeyChecking=accept-new"
SSH_OPTS="-o StrictHostKeyChecking=accept-new"

# Public URL for the post-deploy check (proves DNS + nginx + TLS + firewall).
# Put the real host in ops/deploy.env; leave empty to skip the public probe
# (local /health is always checked).
PUBLIC_URL="https://<your-subdomain>"
